{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/compliance.schema.json",
  "title": "Governed Compliance Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "run_id", "decision", "controls"],
  "properties": {
    "contract": {
      "type": "string",
      "const": "governed.compliance/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "block"]
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["allow", "block"]
          }
        }
      }
    }
  }
}
